    {"op": "capture"},
    {"op": "key", "key": "Tab"},
    {"op": "assert", "expect": {"selector": {"tag": "input", "name": "name"}, "focused": false, "value": "c15-temporary-unsaved"}},
    {"op": "capture"},
    {"op": "click", "selector": {"tag": "anchor", "href": "/", "text": "Home"}},
