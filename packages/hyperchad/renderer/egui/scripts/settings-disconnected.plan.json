    {"op": "assert", "expect": {"route": "/settings"}},
    {"op": "assert", "expect": {"selector": {"id": "settings-music-api-settings-section"}}},
    {"op": "assert", "expect": {"selector": {"tag": "input", "name": "name"}, "visible": true, "value": ""}},
