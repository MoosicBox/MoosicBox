{
  "version": 1,
  "phases": [
    {"op": "scale", "logical_client": [1000, 700]},
    {"op": "assert", "expect": {"selector": {"id": "font-light-300"}, "visible": true}},
    {"op": "assert", "expect": {"selector": {"id": "font-regular-400"}, "visible": true}},
    {"op": "assert", "expect": {"selector": {"id": "font-bold-700"}, "visible": true}},
    {"op": "capture"},
    {"op": "click", "selector": {"id": "canvas-draw"}},
    {"op": "capture"},
    {"op": "click", "selector": {"id": "canvas-clear"}},
    {"op": "capture"},
    {"op": "click", "selector": {"id": "canvas-replay"}},
    {"op": "capture"},
    {"op": "pixels", "before": 2, "after": 4, "selector": {"id": "acceptance-canvas"}, "equal": true},
    {"op": "pixels", "before": 2, "after": 3, "selector": {"id": "acceptance-canvas"}, "equal": false},
    {"op": "pixels", "before": 1, "after": 3, "selector": {"id": "acceptance-canvas"}, "equal": true},
    {"op": "click", "selector": {"id": "open-modal"}},
    {"op": "assert", "expect": {"selector": {"id": "acceptance-modal"}, "visible": true}},
    {"op": "assert", "expect": {"selector": {"scroll_ancestor": {"id": "modal-first-row"}}, "scroll_max_y_min": 1}},
    {"op": "capture"},
    {"op": "wheel", "selector": {"scroll_ancestor": {"id": "modal-first-row"}}, "ticks": 4, "settle_frames": 2},
    {"op": "capture"},
    {"op": "sticky", "before": 5, "after": 6, "header": {"id": "modal-heading"}, "content": {"id": "modal-first-row"}},
    {"op": "click", "selector": {"button_within": {"id": "acceptance-modal"}}},
    {"op": "assert", "expect": {"selector": {"id": "acceptance-modal"}, "visible": false}},
    {"op": "click", "selector": {"id": "open-modal"}},
    {"op": "assert", "expect": {"selector": {"id": "acceptance-modal"}, "visible": true}},
    {"op": "capture"},
    {"op": "outside", "selector": {"id": "acceptance-modal"}, "content": {"id": "modal-first-row"}},
    {"op": "assert", "expect": {"selector": {"id": "acceptance-modal"}, "visible": false}},
    {"op": "capture"}
  ]
}
